      "fade_in_duration",
      "fade_out_duration",
      "use_tiled_vae",
      "unload_models_after_generate",
      "voice_boost",
      "apg_eta",
      "apg_momentum",
      "apg_norm_threshold",
      "guidance_interval",
      "guidance_interval_decay",
      "min_guidance_scale",
      "guidance_scale_text",
      "guidance_scale_lyric",
      "omega_scale",
      "erg_scale",
      "cfg_interval_start",
      "cfg_interval_end",
      "shift"
    ],
    "outputs": [
      {
        "is_list": false,
        "name": "model",
        "type": "MODEL"
      },
      {
        "is_list": false,
        "name": "vae",
        "type": "VAE"
      },
      {
        "is_list": false,
        "name": "positive",
        "type": "CONDITIONING"
      },
      {
        "is_list": false,
        "name": "negative",
        "type": "CONDITIONING"
      },
      {
        "is_list": false,
        "name": "latent",
        "type": "LATENT"
      },
      {
        "is_list": false,
        "name": "audio",
        "type": "AUDIO"
      }
    ],
    "pack": "ComfyUI-AceStep_SFT",
    "pack_version": "local-c2cfe8e",
    "python_module": "ComfyUI-AceStep_SFT.nodes"
