  "AceStepSFTMusicAnalyzer": {
    "category": "audio/AceStep SFT",
    "description": "",
    "display_name": "AceStepSFTMusicAnalyzer",
    "function": "analyze",
    "input_order": {
      "optional": [
        "max_new_tokens",
        "audio_duration",
        "unload_model",
        "use_flash_attn",
        "temperature",
        "top_p",
        "top_k",
        "repetition_penalty",
        "seed"
      ],
      "required": [
        "audio",
        "get_tags",
        "get_bpm",
        "get_keyscale"
      ]
    },
    "input_order_all": [
      "audio",
      "get_tags",
      "get_bpm",
      "get_keyscale",
      "max_new_tokens",
      "audio_duration",
      "unload_model",
      "use_flash_attn",
      "temperature",
      "top_p",
      "top_k",
      "repetition_penalty",
      "seed"
    ],
    "inputs": {
      "optional": {
        "audio_duration": [
          "INT",
          {
            "default": 60,
            "max": 300,
            "min": 10,
            "step": 5,
            "tooltip": "Max seconds of audio to analyze (center crop). ACE-Step Transcriber benefits from more context for sections and lyrics."
          }
        ],
        "max_new_tokens": [
          "INT",
          {
            "default": 256,
            "max": 2000,
            "min": 64,
            "step": 16,
            "tooltip": "Maximum tokens for the native ACE-Step transcription output. Higher values preserve more lyric/structure detail."
          }
        ],
        "repetition_penalty": [
          "FLOAT",
          {
            "default": 1.1,
            "max": 3.0,
            "min": 1.0,
            "step": 0.05,
            "tooltip": "Penalty against repeated tokens in the transcription output. 1.1 is a mild safeguard against loops."
          }
        ],
        "seed": [
          "INT",
          {
            "control_after_generate": true,
            "default": 0,
            "max": 18446744073709551615,
            "min": 0,
            "tooltip": "Random seed for reproducible transcription generation when sampling is enabled."
          }
        ],
        "temperature": [
          "FLOAT",
          {
            "default": 0.0,
            "max": 2.0,
            "min": 0.0,
            "step": 0.05,
            "tooltip": "Sampling temperature for transcription generation. 0 = deterministic and recommended for stable structure extraction."
          }
        ],
        "top_k": [
          "INT",
          {
            "default": 0,
            "max": 200,
            "min": 0,
            "step": 1,
            "tooltip": "Top-K sampling for transcription generation. 0 preserves the native default behavior."
          }
        ],
        "top_p": [
          "FLOAT",
          {
            "default": 1.0,
            "max": 1.0,
            "min": 0.0,
            "step": 0.05,
            "tooltip": "Nucleus sampling for transcription generation. Keep at 1.0 for native deterministic behavior unless you are experimenting."
          }
        ],
        "unload_model": [
          "BOOLEAN",
          {
            "default": true,
            "tooltip": "Unload the ACE-Step transcriber after use to free VRAM for generation."
          }
        ],
        "use_flash_attn": [
          "BOOLEAN",
          {
            "default": false,
            "tooltip": "Use FlashAttention-2 for the ACE-Step transcriber. Requires flash-attn package installed. Faster and uses less VRAM."
          }
        ]
      },
      "required": {
        "audio": [
          "AUDIO",
          {
            "tooltip": "Audio to analyze for style, BPM and key/scale."
          }
        ],
        "get_bpm": [
          "BOOLEAN",
          {
            "default": true,
            "tooltip": "Detect BPM from audio using librosa."
          }
        ],
        "get_keyscale": [
          "BOOLEAN",
          {
            "default": true,
            "tooltip": "Detect key and scale from audio using librosa."
          }
        ],
        "get_tags": [
          "BOOLEAN",
          {
            "default": true,
            "tooltip": "Extract descriptive tags from the audio using the native ACE-Step transcriber."
          }
        ]
      }
    },
    "name": "AceStepSFTMusicAnalyzer",
    "object_info_widget_order": [
      null,
      "get_tags",
      "get_bpm",
      "get_keyscale",
      "max_new_tokens",
      "audio_duration",
      "unload_model",
      "use_flash_attn",
      "temperature",
      "top_p",
      "top_k",
      "repetition_penalty",
      "seed"
    ],
    "outputs": [
      {
        "is_list": false,
        "name": "tags",
        "type": "STRING"
      },
      {
        "is_list": false,
        "name": "bpm",
        "type": "INT"
      },
      {
        "is_list": false,
        "name": "keyscale",
        "type": "STRING"
      },
      {
        "is_list": false,
        "name": "music_infos",
        "type": "STRING"
      }
    ],
    "pack": "ComfyUI-AceStep_SFT",
    "pack_version": "local-c2cfe8e",
    "python_module": "ComfyUI-AceStep_SFT.nodes"
  },
