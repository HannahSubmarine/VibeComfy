{
  "AceStepSFTGenerate": {
    "category": "audio/AceStep SFT",
    "description": "",
    "display_name": "AceStepSFTGenerate",
    "function": "generate",
    "input_order": {
      "optional": [
        "vae",
        "latent_or_audio",
        "batch_size",
        "latent_shift",
        "latent_rescale",
        "fade_in_duration",
        "fade_out_duration",
        "use_tiled_vae",
        "unload_models_after_generate",
        "voice_boost",
        "apg_eta",
        "apg_momentum",
        "apg_norm_threshold",
        "guidance_interval",
        "guidance_interval_decay",
        "min_guidance_scale",
        "guidance_scale_text",
        "guidance_scale_lyric",
        "omega_scale",
        "erg_scale",
        "cfg_interval_start",
        "cfg_interval_end",
        "shift"
      ],
      "required": [
        "model",
        "positive",
        "negative",
        "seed",
        "steps",
        "cfg",
        "sampler_name",
        "scheduler",
        "denoise",
        "duration",
        "infer_method",
        "guidance_mode"
      ]
    },
    "input_order_all": [
      "model",
      "positive",
      "negative",
      "seed",
      "steps",
      "cfg",
      "sampler_name",
      "scheduler",
      "denoise",
      "duration",
      "infer_method",
      "guidance_mode",
      "vae",
      "latent_or_audio",
      "batch_size",
      "latent_shift",
      "latent_rescale",
      "fade_in_duration",
      "fade_out_duration",
      "use_tiled_vae",
      "unload_models_after_generate",
      "voice_boost",
      "apg_eta",
      "apg_momentum",
      "apg_norm_threshold",
      "guidance_interval",
      "guidance_interval_decay",
      "min_guidance_scale",
      "guidance_scale_text",
      "guidance_scale_lyric",
      "omega_scale",
      "erg_scale",
      "cfg_interval_start",
      "cfg_interval_end",
      "shift"
    ],
    "inputs": {
      "optional": {
        "apg_eta": [
          "FLOAT",
          {
            "default": 0.0,
            "max": 10.0,
            "min": -10.0,
            "step": 0.05,
            "tooltip": "APG eta: parallel component retention."
          }
        ],
        "apg_momentum": [
          "FLOAT",
          {
            "default": -0.75,
            "max": 1.0,
            "min": -1.0,
            "step": 0.05,
            "tooltip": "APG momentum buffer coefficient."
          }
        ],
        "apg_norm_threshold": [
          "FLOAT",
          {
            "default": 2.5,
            "max": 15.0,
            "min": 0.0,
            "step": 0.1,
            "tooltip": "APG norm threshold for gradient clipping."
          }
        ],
        "batch_size": [
          "INT",
          {
            "default": 1,
            "max": 16,
            "min": 1,
            "tooltip": "Number of audios to generate in parallel."
          }
        ],
        "cfg_interval_end": [
          "FLOAT",
          {
            "default": 1.0,
            "max": 1.0,
            "min": 0.0,
            "step": 0.05
          }
        ],
        "cfg_interval_start": [
          "FLOAT",
          {
            "default": 0.0,
            "max": 1.0,
            "min": 0.0,
            "step": 0.05
          }
        ],
        "erg_scale": [
          "FLOAT",
          {
            "default": 0.0,
            "max": 2.0,
            "min": -0.9,
            "step": 0.05
          }
        ],
        "fade_in_duration": [
          "FLOAT",
          {
            "default": 0.0,
            "max": 10.0,
            "min": 0.0,
            "step": 0.1
          }
        ],
        "fade_out_duration": [
          "FLOAT",
          {
            "default": 0.0,
            "max": 10.0,
            "min": 0.0,
            "step": 0.1
          }
        ],
        "guidance_interval": [
          "FLOAT",
          {
            "default": 0.5,
            "max": 1.0,
            "min": -1.0,
            "step": 0.01,
            "tooltip": "Guidance interval width. -1 = use legacy cfg_interval_start/end."
          }
        ],
        "guidance_interval_decay": [
          "FLOAT",
          {
            "default": 0.0,
            "max": 1.0,
            "min": 0.0,
            "step": 0.01
          }
        ],
        "guidance_scale_lyric": [
          "FLOAT",
          {
            "default": -1.0,
            "max": 30.0,
            "min": -1.0,
            "step": 0.1,
            "tooltip": "Split lyric guidance. Active when both text and lyric > 1.0."
          }
        ],
        "guidance_scale_text": [
          "FLOAT",
          {
            "default": -1.0,
            "max": 30.0,
            "min": -1.0,
            "step": 0.1,
            "tooltip": "Split text guidance. Active when both text and lyric > 1.0."
          }
        ],
        "latent_or_audio": [
          "AUDIO,LATENT",
          {
            "tooltip": "Base input for refinement (img2img). Use denoise < 1.0."
          }
        ],
        "latent_rescale": [
          "FLOAT",
          {
            "default": 1.0,
            "max": 1.5,
            "min": 0.5,
            "step": 0.01,
            "tooltip": "Multiplicative scale on latents before VAE decode."
          }
        ],
        "latent_shift": [
          "FLOAT",
          {
            "default": 0.0,
            "max": 0.2,
            "min": -0.2,
            "step": 0.01,
            "tooltip": "Additive shift on latents before VAE decode."
          }
        ],
        "min_guidance_scale": [
          "FLOAT",
          {
            "default": 3.0,
            "max": 30.0,
            "min": 0.0,
            "step": 0.1
          }
        ],
        "omega_scale": [
          "FLOAT",
          {
            "default": 0.0,
            "max": 8.0,
            "min": -8.0,
            "step": 0.05
          }
        ],
        "shift": [
          "FLOAT",
          {
            "default": 3.0,
            "max": 5.0,
            "min": 0.0,
            "step": 0.1,
            "tooltip": "Timestep schedule shift. ACEStep15 default is 3.0."
          }
        ],
        "unload_models_after_generate": [
          "BOOLEAN",
          {
            "default": false,
            "tooltip": "Unload models from memory after generation."
          }
        ],
        "use_tiled_vae": [
          "BOOLEAN",
          {
            "default": true,
            "tooltip": "Use tiled VAE for long audio / low VRAM."
          }
        ],
        "vae": [
          "VAE",
          {
            "tooltip": "VAE for decoding latents to audio. Audio output requires this."
          }
        ],
        "voice_boost": [
          "FLOAT",
          {
            "default": 0.0,
            "max": 12.0,
            "min": -12.0,
            "step": 0.5,
            "tooltip": "Voice boost in dB."
          }
        ]
      },
      "required": {
        "cfg": [
          "FLOAT",
          {
            "default": 7.0,
            "max": 20.0,
            "min": 1.0,
            "step": 0.1,
            "tooltip": "Classifier-free guidance scale."
          }
        ],
        "denoise": [
          "FLOAT",
          {
            "default": 1.0,
            "max": 1.0,
            "min": 0.0,
            "step": 0.01,
            "tooltip": "Denoise strength. 1.0 = full generation. < 1.0 requires latent_or_audio."
          }
        ],
        "duration": [
          "FLOAT",
          {
            "default": 60.0,
            "max": 600.0,
            "min": 0.0,
            "step": 0.1,
            "tooltip": "Duration in seconds. Set to 0 for auto from latent_or_audio."
          }
        ],
        "guidance_mode": [
          [
            "apg",
            "adg",
            "standard_cfg"
          ],
          {
            "default": "apg",
            "tooltip": "APG = Adaptive Projected Guidance. ADG = Angle-based Dynamic Guidance. standard_cfg = normal CFG."
          }
        ],
        "infer_method": [
          [
            "ode",
            "sde"
          ],
          {
            "default": "ode",
            "tooltip": "ode = deterministic diffusion. sde = stochastic (remaps sampler)."
          }
        ],
        "model": [
          "MODEL",
          {
            "tooltip": "AceStep 1.5 diffusion model (from Load Diffusion Model or with LoRA applied)."
          }
        ],
        "negative": [
          "CONDITIONING",
          {
            "tooltip": "Negative conditioning from AceStep 1.5 SFT TextEncode."
          }
        ],
        "positive": [
          "CONDITIONING",
          {
            "tooltip": "Positive conditioning from AceStep 1.5 SFT TextEncode."
          }
        ],
        "sampler_name": [
          "<class '__main__.KSampler.SAMPLERS'>",
          {
            "default": "euler"
          }
        ],
        "scheduler": [
          "<class '__main__.KSampler.SCHEDULERS'>",
          {
            "default": "normal"
          }
        ],
        "seed": [
          "INT",
          {
            "control_after_generate": true,
            "default": 0,
            "max": 18446744073709551615,
            "min": 0
          }
        ],
        "steps": [
          "INT",
          {
            "default": 50,
            "max": 200,
            "min": 1,
            "step": 1,
            "tooltip": "Diffusion inference steps."
          }
        ]
      }
    },
    "name": "AceStepSFTGenerate",
    "object_info_widget_order": [
      null,
      null,
      null,
      "seed",
