{
  "Hy3DTools_BackProjectInpaint": {
    "category": "Hunyuan3DTools",
    "description": "",
    "display_name": "Hy3DTools_BackProjectInpaint",
    "function": "back_project_inpaint",
    "input_order": {
      "required": [
        "original_mesh",
        "inpainted_view",
        "camera_params",
        "blend_threshold"
      ]
    },
    "input_order_all": [
      "original_mesh",
      "inpainted_view",
      "camera_params",
      "blend_threshold"
    ],
    "inputs": {
      "required": {
        "blend_threshold": [
          "FLOAT",
          {
            "default": 0.8,
            "max": 1.0,
            "min": 0.0,
            "step": 0.01,
            "tooltip": "Confidence threshold (from cos map) to use inpainted pixels."
          }
        ],
        "camera_params": [
          "CAMERA_PARAMS"
        ],
        "inpainted_view": [
          "IMAGE"
        ],
        "original_mesh": [
          "TRIMESH"
        ]
      }
    },
    "name": "Hy3DTools_BackProjectInpaint",
    "object_info_widget_order": [
      "original_mesh",
      null,
      "camera_params",
      "blend_threshold"
    ],
    "outputs": [
      {
        "is_list": false,
        "name": "updated_mesh",
        "type": "TRIMESH"
      }
    ],
    "pack": "ComfyUI-Hunyuan3DTools",
    "pack_version": "local-621fb54",
    "python_module": "ComfyUI-Hunyuan3DTools.nodes"
  },
  "Hy3DTools_RenderSpecificView": {
    "category": "Hunyuan3DTools",
    "description": "",
    "display_name": "Hy3DTools_RenderSpecificView",
    "function": "render_view",
    "input_order": {
      "required": [
        "trimesh",
        "render_size",
        "camera_type",
        "camera_distance",
        "pan_x",
        "pan_y",
        "ortho_scale",
        "azimuth",
        "elevation",
        "bg_color_rgb"
      ]
    },
    "input_order_all": [
      "trimesh",
      "render_size",
      "camera_type",
      "camera_distance",
      "pan_x",
      "pan_y",
      "ortho_scale",
      "azimuth",
      "elevation",
      "bg_color_rgb"
    ],
    "inputs": {
      "required": {
        "azimuth": [
          "FLOAT",
          {
            "default": 0,
            "max": 360,
            "min": -360,
            "step": 1
          }
        ],
        "bg_color_rgb": [
          "STRING",
          {
            "default": "128, 128, 255",
            "tooltip": "Background Color (RGB 0-255). Used for textured, world normal, and position views."
          }
        ],
        "camera_distance": [
          "FLOAT",
          {
            "default": 1.45,
            "max": 10.0,
            "min": 0.1,
            "step": 0.001
          }
        ],
        "camera_type": [
          [
            "orth",
            "perspective"
          ],
          {
            "default": "orth"
          }
        ],
        "elevation": [
          "FLOAT",
          {
            "default": 0,
            "max": 360,
            "min": -360,
            "step": 1
          }
        ],
        "ortho_scale": [
          "FLOAT",
          {
            "default": 1.2,
            "max": 10.0,
            "min": 0.1,
            "step": 0.001
          }
        ],
        "pan_x": [
          "FLOAT",
          {
            "default": 0.0,
            "max": 1.0,
            "min": -1.0,
            "step": 0.01
          }
        ],
        "pan_y": [
          "FLOAT",
          {
            "default": 0.0,
            "max": 1.0,
            "min": -1.0,
            "step": 0.01
          }
        ],
        "render_size": [
          "INT",
          {
            "default": 512,
            "max": 4096,
            "min": 64,
            "step": 16
          }
        ],
        "trimesh": [
          "TRIMESH"
        ]
      }
    },
    "name": "Hy3DTools_RenderSpecificView",
    "object_info_widget_order": [
      "trimesh",
      "render_size",
      "camera_type",
      "camera_distance",
      "pan_x",
      "pan_y",
      "ortho_scale",
