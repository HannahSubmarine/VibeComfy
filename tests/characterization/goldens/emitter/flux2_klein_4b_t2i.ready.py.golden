    cliptextencode_3 = CLIPTextEncode(text='', clip=cliploader_2.out('CLIP'))

    cfgguider = CFGGuider(
        cfg=GUIDE_STRENGTH,
        model=unetloader_2.out('MODEL'),
        negative=cliptextencode_2.out('CONDITIONING'),
        positive=cliptextencode_3.out('CONDITIONING'),
    )

    conditioningzeroout = ConditioningZeroOut(
        conditioning=cliptextencode.out('CONDITIONING'),
    )

    samplercustomadvanced = SamplerCustomAdvanced(
        guider=cfgguider.out('GUIDER'),
        latent_image=emptyflux2latentimage_2.out('LATENT'),
        noise=randomnoise_2.out('NOISE'),
        sampler=ksamplerselect.out('SAMPLER'),
        sigmas=flux2scheduler_2.out('SIGMAS'),
    )

    cfgguider_2 = CFGGuider(
        cfg=GUIDE_STRENGTH_2,
        model=unetloader.out('MODEL'),
        negative=conditioningzeroout.out('CONDITIONING'),
        positive=cliptextencode.out('CONDITIONING'),
    )

    # Decode
    vaedecode = VAEDecode(
        samples=samplercustomadvanced.out('OUTPUT'),
        vae=vaeloader_2.out('VAE'),
    )

    samplercustomadvanced_2 = SamplerCustomAdvanced(
        guider=cfgguider_2.out('GUIDER'),
        latent_image=emptyflux2latentimage.out('LATENT'),
        noise=randomnoise.out('NOISE'),
        sampler=ksamplerselect_2.out('SAMPLER'),
        sigmas=flux2scheduler.out('SIGMAS'),
    )

    # Outputs
    saveimage = SaveImage(filename_prefix='Flux2-Klein', images=vaedecode.out('IMAGE'))

    vaedecode_2 = VAEDecode(
        samples=samplercustomadvanced_2.out('OUTPUT'),
        vae=vaeloader.out('VAE'),
    )

    saveimage_2 = SaveImage(
        filename_prefix='Flux2-Klein',
        images=vaedecode_2.out('IMAGE'),
    )

    wf = wf.finalize(PUBLIC_INPUT_METADATA, canonical_outputs=[{'node': saveimage, 'output_type': 'SaveImage', 'name': 'image', 'artifact_kind': 'image', 'mime_type': 'image/png', 'filename_prefix': 'Flux2-Klein', 'expected_cardinality': 'one'}, {'node': saveimage_2, 'output_type': 'SaveImage', 'name': None, 'artifact_kind': None, 'mime_type': None, 'filename_prefix': None, 'expected_cardinality': None}], canonical_requirements={'models': ['flux-2-klein-4b.safetensors', 'flux-2-klein-base-4b.safetensors', 'flux2-vae.safetensors', 'qwen_3_4b.safetensors'], 'custom_nodes': [], 'missing_models': [], 'missing_nodes': [], 'unsupported': []}, canonical_custody=CANONICAL_CUSTODY, canonical_bindings={'ksamplerselect': ksamplerselect, 'flux2scheduler_2': flux2scheduler_2, 'emptyflux2latentimage_2': emptyflux2latentimage_2, 'unetloader_2': unetloader_2, 'cliploader_2': cliploader_2, 'vaeloader_2': vaeloader_2, 'randomnoise_2': randomnoise_2, 'ksamplerselect_2': ksamplerselect_2, 'flux2scheduler': flux2scheduler, 'emptyflux2latentimage': emptyflux2latentimage, 'unetloader': unetloader, 'cliploader': cliploader, 'vaeloader': vaeloader, 'randomnoise': randomnoise, 'cliptextencode_2': cliptextencode_2, 'cliptextencode': cliptextencode, 'cliptextencode_3': cliptextencode_3, 'cfgguider': cfgguider, 'conditioningzeroout': conditioningzeroout, 'samplercustomadvanced': samplercustomadvanced, 'cfgguider_2': cfgguider_2, 'vaedecode': vaedecode, 'samplercustomadvanced_2': samplercustomadvanced_2, 'saveimage': saveimage, 'vaedecode_2': vaedecode_2, 'saveimage_2': saveimage_2})
    wf.strict_types = False
    return wf

