def build() -> VibeWorkflow:
    """Build the workflow (auto-generated)."""
    wf = new_workflow(READY_METADATA, source_path=__file__, canonical_custody=CANONICAL_CUSTODY)

    # Loaders
    unetloader = UNETLoader(unet_name=UNET_NAME, weight_dtype='default')
    cliploader = CLIPLoader(clip_name=CLIP_NAME, type='wan')
    vaeloader = VAELoader(vae_name=VAE_NAME)

    # Sampling
    emptyhunyuanlatentvideo = EmptyHunyuanLatentVideo(
        width=DEFAULT_WIDTH,
        height=DEFAULT_HEIGHT,
        length=DEFAULT_FRAMES,
        batch_size=1,
    )

    # Conditioning
    cliptextencode = CLIPTextEncode(text=DEFAULT_PROMPT, clip=cliploader.out('CLIP'))

    cliptextencode_2 = CLIPTextEncode(
        text=DEFAULT_PROMPT_2,
        clip=cliploader.out('CLIP'),
    )

    modelsamplingsd3 = ModelSamplingSD3(shift=8, model=unetloader.out('MODEL'))

    ksampler = KSampler(
        seed=DEFAULT_SEED,
        steps=30,
        cfg=GUIDE_STRENGTH,
        sampler_name='uni_pc',
        scheduler='simple',
        latent_image=emptyhunyuanlatentvideo.out('LATENT'),
        model=modelsamplingsd3.out('MODEL'),
        negative=cliptextencode_2.out('CONDITIONING'),
        positive=cliptextencode.out('CONDITIONING'),
    )

    # Decode
    vaedecode = VAEDecode(samples=ksampler.out('LATENT'), vae=vaeloader.out('VAE'))
    createvideo = CreateVideo(fps=DEFAULT_FPS, images=vaedecode.out('IMAGE'))

    # Outputs
    savevideo = SaveVideo(video=createvideo.out('VIDEO'))

    wf = wf.finalize(PUBLIC_INPUT_METADATA, canonical_outputs=[{'node': savevideo, 'output_type': 'SaveVideo', 'name': 'video', 'artifact_kind': 'video', 'mime_type': 'video/mp4', 'filename_prefix': 'video/ComfyUI', 'expected_cardinality': 'one'}], canonical_requirements={'models': ['umt5_xxl_fp8_e4m3fn_scaled.safetensors', 'wan2.1_t2v_1.3B_fp16.safetensors', 'wan_2.1_vae.safetensors'], 'custom_nodes': [], 'missing_models': [], 'missing_nodes': [], 'unsupported': []}, canonical_custody=CANONICAL_CUSTODY, canonical_bindings={'unetloader': unetloader, 'cliploader': cliploader, 'vaeloader': vaeloader, 'emptyhunyuanlatentvideo': emptyhunyuanlatentvideo, 'cliptextencode': cliptextencode, 'cliptextencode_2': cliptextencode_2, 'modelsamplingsd3': modelsamplingsd3, 'ksampler': ksampler, 'vaedecode': vaedecode, 'createvideo': createvideo, 'savevideo': savevideo})
    wf.strict_types = False
    return wf

