)

def build() -> VibeWorkflow:
    """Build the workflow (auto-generated)."""
    wf = new_workflow(READY_METADATA, source_path=__file__, canonical_custody=CANONICAL_CUSTODY)

    # Loaders
    cliploader = CLIPLoader(clip_name=CLIP_NAME, type='lumina2')
    vaeloader = VAELoader(vae_name=VAE_NAME)
    unetloader = UNETLoader(unet_name=UNET_NAME, weight_dtype='default')

    # Sampling
    emptysd3latentimage = EmptySD3LatentImage(width=1024, height=1024, batch_size=1)

    # Conditioning
    cliptextencode = CLIPTextEncode(text=DEFAULT_PROMPT, clip=cliploader.out('CLIP'))

    modelsamplingauraflow = ModelSamplingAuraFlow(
        shift=3,
        model=unetloader.out('MODEL'),
    )

    cliptextencode_2 = CLIPTextEncode(text='', clip=cliploader.out('CLIP'))

    ksampler = KSampler(
        seed=DEFAULT_SEED,
        steps=25,
        cfg=GUIDE_STRENGTH,
        sampler_name='res_multistep',
        scheduler='simple',
        denoise=1,
        latent_image=emptysd3latentimage.out('LATENT'),
        model=modelsamplingauraflow.out('MODEL'),
        negative=cliptextencode_2.out('CONDITIONING'),
        positive=cliptextencode.out('CONDITIONING'),
    )

    # Decode
    vaedecode = VAEDecode(samples=ksampler.out('LATENT'), vae=vaeloader.out('VAE'))

    # Outputs
    saveimage = SaveImage(filename_prefix='z-image', images=vaedecode.out('IMAGE'))

    wf = wf.finalize(PUBLIC_INPUT_METADATA, canonical_outputs=[{'node': saveimage, 'output_type': 'SaveImage', 'name': 'image', 'artifact_kind': 'image', 'mime_type': 'image/png', 'filename_prefix': 'z-image', 'expected_cardinality': 'one'}], canonical_requirements={'models': ['ae.safetensors', 'qwen_3_4b.safetensors', 'z_image_bf16.safetensors'], 'custom_nodes': [], 'missing_models': [], 'missing_nodes': [], 'unsupported': []}, canonical_custody=CANONICAL_CUSTODY, canonical_bindings={'cliploader': cliploader, 'vaeloader': vaeloader, 'unetloader': unetloader, 'emptysd3latentimage': emptysd3latentimage, 'cliptextencode': cliptextencode, 'modelsamplingauraflow': modelsamplingauraflow, 'cliptextencode_2': cliptextencode_2, 'ksampler': ksampler, 'vaedecode': vaedecode, 'saveimage': saveimage})
    wf.strict_types = False
    return wf

