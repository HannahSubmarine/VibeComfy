)

def build() -> VibeWorkflow:
    """Build the workflow (auto-generated)."""
    wf = new_workflow(READY_METADATA, source_path=__file__, canonical_custody=CANONICAL_CUSTODY)

    # Loaders
    unetloader = UNETLoader(unet_name=UNET_NAME, weight_dtype='default')
    cliploader = CLIPLoader(clip_name=CLIP_NAME, type='wan', device='default')
    vaeloader = VAELoader(vae_name=VAE_NAME)
    clipvisionloader = CLIPVisionLoader(clip_name=CLIP_NAME_2)

    # Inputs
    loadimage = LoadImage(image=DEFAULT_IMAGE)

    # Conditioning
    cliptextencode = CLIPTextEncode(text=DEFAULT_PROMPT, clip=cliploader.out('CLIP'))

    cliptextencode_2 = CLIPTextEncode(
        text=DEFAULT_PROMPT_2,
        clip=cliploader.out('CLIP'),
    )

    clipvisionencode = CLIPVisionEncode(
        crop='none',
        clip_vision=clipvisionloader.out('CLIP_VISION'),
        image=loadimage.out('IMAGE'),
    )

    modelsamplingsd3 = ModelSamplingSD3(shift=8, model=unetloader.out('MODEL'))

    wanimagetovideo = WanImageToVideo(
        width=512,
        height=512,
        length=DEFAULT_FRAMES,
        batch_size=1,
        clip_vision_output=clipvisionencode.out('CLIP_VISION_OUTPUT'),
        negative=cliptextencode_2.out('CONDITIONING'),
        positive=cliptextencode.out('CONDITIONING'),
        start_image=loadimage.out('IMAGE'),
        vae=vaeloader.out('VAE'),
    )

    # Sampling
    ksampler = KSampler(
        seed=DEFAULT_SEED,
        steps=20,
        cfg=GUIDE_STRENGTH,
        sampler_name='uni_pc',
        scheduler='simple',
        denoise=1,
        latent_image=wanimagetovideo.out('LATENT'),
        model=modelsamplingsd3.out('MODEL'),
        negative=wanimagetovideo.out('NEGATIVE'),
        positive=wanimagetovideo.out('POSITIVE'),
    )

    # Decode
    vaedecode = VAEDecode(samples=ksampler.out('LATENT'), vae=vaeloader.out('VAE'))
    createvideo = CreateVideo(fps=DEFAULT_FPS, images=vaedecode.out('IMAGE'))

    # Outputs
    savevideo = SaveVideo(
        filename_prefix='video/ComfyUI',
        format='auto',
        codec='auto',
        video=createvideo.out('VIDEO'),
    )

    wf = wf.finalize(PUBLIC_INPUT_METADATA, canonical_outputs=[{'node': savevideo, 'output_type': 'SaveVideo', 'name': 'video', 'artifact_kind': 'video', 'mime_type': 'video/mp4', 'filename_prefix': 'video/ComfyUI', 'expected_cardinality': 'one'}], canonical_requirements={'models': ['clip_vision_h.safetensors', 'umt5_xxl_fp8_e4m3fn_scaled.safetensors', 'wan2.1_i2v_480p_14B_fp16.safetensors', 'wan_2.1_vae.safetensors'], 'custom_nodes': [], 'missing_models': [], 'missing_nodes': [], 'unsupported': []}, canonical_custody=CANONICAL_CUSTODY, canonical_bindings={'unetloader': unetloader, 'cliploader': cliploader, 'vaeloader': vaeloader, 'clipvisionloader': clipvisionloader, 'loadimage': loadimage, 'cliptextencode': cliptextencode, 'cliptextencode_2': cliptextencode_2, 'clipvisionencode': clipvisionencode, 'modelsamplingsd3': modelsamplingsd3, 'wanimagetovideo': wanimagetovideo, 'ksampler': ksampler, 'vaedecode': vaedecode, 'createvideo': createvideo, 'savevideo': savevideo})
    wf.strict_types = False
    return wf

