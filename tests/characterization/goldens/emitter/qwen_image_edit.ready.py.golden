)

def build() -> VibeWorkflow:
    """Build the workflow (auto-generated)."""
    wf = new_workflow(READY_METADATA, source_path=__file__, canonical_custody=CANONICAL_CUSTODY)

    # Loaders
    unetloader = UNETLoader(unet_name=UNET_NAME)
    cliploader = CLIPLoader(clip_name=CLIP_NAME, type='qwen_image')
    vaeloader = VAELoader(vae_name=VAE_NAME)
    comfyswitchnode_2 = ComfySwitchNode(switch=False)
    comfyswitchnode_3 = ComfySwitchNode(switch=False)

    # Inputs
    loadimage = LoadImage(image=DEFAULT_IMAGE)

    textencodeqwenimageedit = TextEncodeQwenImageEdit(
        prompt=DEFAULT_PROMPT,
        clip=cliploader.out('CLIP'),
        image=loadimage.out('IMAGE'),
        vae=vaeloader.out('VAE'),
    )

    textencodeqwenimageedit_2 = TextEncodeQwenImageEdit(
        prompt='',
        clip=cliploader.out('CLIP'),
        image=loadimage.out('IMAGE'),
        vae=vaeloader.out('VAE'),
    )

    vaeencode = VAEEncode(pixels=loadimage.out('IMAGE'), vae=vaeloader.out('VAE'))

    loraloadermodelonly = LoraLoaderModelOnly(
        lora_name=LORA_NAME,
        model=unetloader.out('MODEL'),
    )

    comfyswitchnode = ComfySwitchNode(
        switch=False,
        on_false=unetloader.out('MODEL'),
        on_true=loraloadermodelonly.out('MODEL'),
    )

    modelsamplingauraflow = ModelSamplingAuraFlow(
        shift=3,
        model=comfyswitchnode.out('OUTPUT'),
    )

    cfgnorm = CFGNorm(widget_0=1, model=modelsamplingauraflow.out('MODEL'))

    # Sampling
    ksampler = KSampler(
        seed=DEFAULT_SEED,
        sampler_name='euler',
        steps=comfyswitchnode_3.out('OUTPUT'),
        cfg=comfyswitchnode_2.out('OUTPUT'),
        latent_image=vaeencode.out('LATENT'),
        model=cfgnorm.out('PATCHED_MODEL'),
        negative=textencodeqwenimageedit_2.out('CONDITIONING'),
        positive=textencodeqwenimageedit.out('CONDITIONING'),
    )

    # Decode
    vaedecode = VAEDecode(samples=ksampler.out('LATENT'), vae=vaeloader.out('VAE'))

    # Outputs
    saveimage = SaveImage(images=vaedecode.out('IMAGE'))

    wf = wf.finalize(PUBLIC_INPUT_METADATA, canonical_outputs=[{'node': saveimage, 'output_type': 'SaveImage', 'name': 'image', 'artifact_kind': 'image', 'mime_type': 'image/png', 'filename_prefix': 'ComfyUI', 'expected_cardinality': 'one'}], canonical_requirements={'models': ['Qwen-Image-Edit-Lightning-4steps-V1.0-bf16.safetensors', 'qwen_2.5_vl_7b_fp8_scaled.safetensors', 'qwen_image_edit_fp8_e4m3fn.safetensors', 'qwen_image_vae.safetensors'], 'custom_nodes': [], 'missing_models': [], 'missing_nodes': [], 'unsupported': []}, canonical_custody=CANONICAL_CUSTODY, canonical_bindings={'unetloader': unetloader, 'cliploader': cliploader, 'vaeloader': vaeloader, 'comfyswitchnode_2': comfyswitchnode_2, 'comfyswitchnode_3': comfyswitchnode_3, 'loadimage': loadimage, 'textencodeqwenimageedit': textencodeqwenimageedit, 'textencodeqwenimageedit_2': textencodeqwenimageedit_2, 'vaeencode': vaeencode, 'loraloadermodelonly': loraloadermodelonly, 'comfyswitchnode': comfyswitchnode, 'modelsamplingauraflow': modelsamplingauraflow, 'cfgnorm': cfgnorm, 'ksampler': ksampler, 'vaedecode': vaedecode, 'saveimage': saveimage})
    wf.strict_types = False
    return wf

