READY_METADATA = ReadyMetadata.build(
    capability='image',
    template_id='edit/qwen_image_edit',
    inputs=PUBLIC_INPUT_METADATA,
    requirements={'models': ['Qwen-Image-Edit-Lightning-4steps-V1.0-bf16.safetensors', 'qwen_2.5_vl_7b_fp8_scaled.safetensors', 'qwen_image_edit_fp8_e4m3fn.safetensors', 'qwen_image_vae.safetensors']},
    source_path='ready_templates/sources/official/edit/qwen_image_edit.json',
    source_id='edit/qwen_image_edit',
