def build() -> VibeWorkflow:
    """Build the workflow (auto-generated)."""
    wf = new_workflow(READY_METADATA, source_path=__file__, canonical_custody=CANONICAL_CUSTODY)

    # Sampling
    ksamplerselect = KSamplerSelect(sampler_name='euler')
    flux2scheduler = Flux2Scheduler()
    emptyflux2latentimage = EmptyFlux2LatentImage()

    # Loaders
    unetloader = UNETLoader(unet_name=UNET_NAME)
    cliploader = CLIPLoader(clip_name=CLIP_NAME, type='flux2')
    vaeloader = VAELoader(vae_name=VAE_NAME)

    randomnoise = RandomNoise(
        noise_seed=DEFAULT_SEED,
        control_after_generate='randomize',
    )

    # Conditioning
    cliptextencode = CLIPTextEncode(text='', clip=cliploader.out('CLIP'))
    cliptextencode_2 = CLIPTextEncode(text='', clip=cliploader.out('CLIP'))

    cfgguider = CFGGuider(
        cfg=GUIDE_STRENGTH,
        model=unetloader.out('MODEL'),
        negative=cliptextencode.out('CONDITIONING'),
        positive=cliptextencode_2.out('CONDITIONING'),
    )

    samplercustomadvanced = SamplerCustomAdvanced(
        guider=cfgguider.out('GUIDER'),
        latent_image=emptyflux2latentimage.out('LATENT'),
        noise=randomnoise.out('NOISE'),
        sampler=ksamplerselect.out('SAMPLER'),
        sigmas=flux2scheduler.out('SIGMAS'),
    )

    # Decode
    vaedecode = VAEDecode(
        samples=samplercustomadvanced.out('OUTPUT'),
        vae=vaeloader.out('VAE'),
    )

    # Outputs
    saveimage = SaveImage(filename_prefix='Flux2-Klein', images=vaedecode.out('IMAGE'))

    wf = wf.finalize(PUBLIC_INPUT_METADATA, canonical_outputs=[{'node': saveimage, 'output_type': 'SaveImage', 'name': 'image', 'artifact_kind': 'image', 'mime_type': 'image/png', 'filename_prefix': 'Flux2-Klein', 'expected_cardinality': 'one'}], canonical_requirements={'models': ['flux-2-klein-base-9b-fp8.safetensors', 'full_encoder_small_decoder.safetensors', 'qwen_3_8b_fp8mixed.safetensors'], 'custom_nodes': [], 'missing_models': [], 'missing_nodes': [], 'unsupported': []}, canonical_custody=CANONICAL_CUSTODY, canonical_bindings={'ksamplerselect': ksamplerselect, 'flux2scheduler': flux2scheduler, 'emptyflux2latentimage': emptyflux2latentimage, 'unetloader': unetloader, 'cliploader': cliploader, 'vaeloader': vaeloader, 'randomnoise': randomnoise, 'cliptextencode': cliptextencode, 'cliptextencode_2': cliptextencode_2, 'cfgguider': cfgguider, 'samplercustomadvanced': samplercustomadvanced, 'vaedecode': vaedecode, 'saveimage': saveimage})
    wf.strict_types = False
    return wf

