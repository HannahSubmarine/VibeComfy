        latent=vaeencode_2.out('LATENT'),
    )

    referencelatent_4 = ReferenceLatent(
        conditioning=cliptextencode.out('CONDITIONING'),
        latent=vaeencode_2.out('LATENT'),
    )

    cfgguider = CFGGuider(
        cfg=GUIDE_STRENGTH,
        model=unetloader_2.out('MODEL'),
        negative=referencelatent_2.out('CONDITIONING'),
        positive=referencelatent.out('CONDITIONING'),
    )

    referencelatent_5 = ReferenceLatent(
        conditioning=referencelatent_3.out('CONDITIONING'),
        latent=vaeencode_3.out('LATENT'),
    )

    referencelatent_6 = ReferenceLatent(
        conditioning=referencelatent_4.out('CONDITIONING'),
        latent=vaeencode_3.out('LATENT'),
    )

    samplercustomadvanced = SamplerCustomAdvanced(
        guider=cfgguider.out('GUIDER'),
        latent_image=emptyflux2latentimage.out('LATENT'),
        noise=randomnoise_2.out('NOISE'),
        sampler=ksamplerselect_2.out('SAMPLER'),
        sigmas=flux2scheduler.out('SIGMAS'),
    )

    cfgguider_2 = CFGGuider(
        cfg=GUIDE_STRENGTH,
        model=unetloader.out('MODEL'),
        negative=referencelatent_5.out('CONDITIONING'),
        positive=referencelatent_6.out('CONDITIONING'),
    )

    # Decode
    vaedecode = VAEDecode(
        samples=samplercustomadvanced.out('OUTPUT'),
